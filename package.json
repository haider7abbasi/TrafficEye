{
  "name": "TrafficEye",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --port 9081",
    "reverse:metro": "adb reverse tcp:9081 tcp:9081",
    "ios": "react-native run-ios --port 9081",
    "lint": "eslint .",
    "cleanup:expired": "node scripts/cleanup-expired-challans.cjs",
    "firebase:deploy": "node scripts/firebase-deploy.cjs",
    "firebase:login": "firebase login",
    "preflight": "node scripts/preflight-check.cjs",
    "seed:user": "node scripts/seed-static-user.cjs",
    "start": "react-native start --port 9081",
    "clean:cache": "npx react-native clean --include metro,android",
    "clean:android": "cd android && gradlew.bat clean",
    "clean:build": "npx react-native clean --include metro,android && cd android && gradlew.bat clean",
    "test": "jest",
    "test:processing": "jest __tests__/violationProcessingFlow.test.ts __tests__/roboflowViolationPolicy.test.ts --verbose"
  },
