# TrafficEye — copy to ".env" and adjust. Restart Metro after changes (`npx react-native start --reset-cache`).
#
# IMPORTANT (React Native + @react-native-firebase):
# - Mobile apps do NOT read API keys from this file for Firebase core.
# - You MUST add native config files from the Firebase Console:
#   • Android: android/app/google-services.json
#   • iOS:     ios/GoogleService-Info.plist (add to Xcode project)
# - Enable Authentication → Sign-in method → Email/Password in Firebase Console.
# - Create Firestore database (production or test mode), then deploy rules (see below).
# - Enable Cloud Storage in Firebase Console; set Storage rules (see android/FIREBASE_SETUP.txt).
# - The app depends on @react-native-firebase/storage (see package.json); rebuild native after npm install.
#
# This .env is for JS-only settings: collection names, emulator hosts, optional Cloud URLs.
#
# Android: register debug/release SHA-1 (and SHA-256) in Firebase Console for this app, then
# optionally re-download google-services.json. See: android/FIREBASE_SETUP.txt

# ---- Firestore document paths (defaults match code fallbacks) ----
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_VIOLATIONS_SUBCOLLECTION=violations

# ---- Local Firebase Emulator (optional) ----
# USE_FIREBASE_EMULATOR=true
# Android emulator → host machine: use 10.0.2.2 ; iOS simulator often uses localhost
# FIRESTORE_EMULATOR_HOST=10.0.2.2
# FIRESTORE_EMULATOR_PORT=8080
# AUTH_EMULATOR_HOST=10.0.2.2
# AUTH_EMULATOR_PORT=9099

# ---- Optional: if you later call HTTPS Cloud Functions / REST from JS ----
# CLOUD_FUNCTIONS_REGION=us-central1
# CLOUD_FUNCTIONS_BASE_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net

# ---- Roboflow (TrafficEye implementation plan) ----
# Never commit a real API key. Copy your key from Roboflow → Settings → API only into local ".env" (gitignored).
# If a key was ever pasted into chat or committed by mistake, rotate it in Roboflow.
ROBOFLOW_API_KEY=
#
# Project slugs + deploy versions — must match Roboflow “Deploy” / Inference URL (see src/config/roboflowModels.ts).
# seatbelt-detection-lb1ec-jborv → v2 | np-recognization → v1 | mobile_phone_detection-hhrf7 → v2 | bike-helmet-sbg4b-kwudk → v2 | vehicles-k83q3-iighp → v1
ROBOFLOW_PROJECT_SEATBELT=seatbelt-detection-lb1ec-jborv
ROBOFLOW_PROJECT_NUMBER_PLATE=np-recognization
ROBOFLOW_PROJECT_MOBILE_PHONE=mobile_phone_detection-hhrf7
ROBOFLOW_PROJECT_BIKE_HELMET=bike-helmet-sbg4b-kwudk
# Vehicle type detector — classes: car, Motorcycle, Bus, truck
# In Roboflow: open the model → Deploy → copy the Inference URL path (project slug + version number).
ROBOFLOW_PROJECT_VEHICLE=vehicles-k83q3-iighp
# Integer only (no "v"): https://detect.roboflow.com/{ROBOFLOW_PROJECT_*}/{ROBOFLOW_VERSION_*}
# If vehicle detection always shows "no vehicle", the version here is usually wrong (e.g. model is v2 but .env says 1).
ROBOFLOW_VERSION_SEATBELT=2
ROBOFLOW_VERSION_NUMBER_PLATE=1
ROBOFLOW_VERSION_MOBILE_PHONE=2
ROBOFLOW_VERSION_BIKE_HELMET=2
ROBOFLOW_VERSION_VEHICLE=1

# ---- Firebase Console checklist (not stored in .env) ----
# [ ] Project settings → Your apps → download google-services.json / GoogleService-Info.plist
# [ ] Authentication → Sign-in method → Email/Password → Enable
# [ ] Firestore → Create database
# [ ] Firestore rules example (tighten for production):
